+    rows.push([
+      q(t.date), q(t.clientName), q(t.offerName), q(ad), q(t.amount), q(t.priceDzd),
+      q(t.launchedByName || t.employeeName || 'Admin'), q(t.status === 'problem' ? 'PROBLÈME' : 'VALIDÉ'), q(t.paid ? 'Oui' : 'Non')

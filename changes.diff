+window.numberToFrenchWords = function(num) {
+  let n = Math.floor(Math.abs(Number(num) || 0));
+  if (n === 0) return 'zéro';
+  const u = ['zéro','un','deux','trois','quatre','cinq','six','sept','huit','neuf','dix','onze','douze','treize','quatorze','quinze','seize'];

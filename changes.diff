+window.exportTransactions = function() {
+  const list = [...(appState.transactions || [])].sort((a, b) => (toTs ? toTs(b) - toTs(a) : 0));
+  const q = (s) => `"${String(s == null ? '' : s).replace(/"/g, '""')}"`;
